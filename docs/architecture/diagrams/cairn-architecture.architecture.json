  "cards": [
    {
      "dot": "violet",
      "title": "Bounded orchestration",
      "items": [
        "Four specialists run in parallel; the planner waits for all four",
        "max_node_executions 12, execution 90s, per-node 30s",
        "Topology fixed at build time: no dynamic nodes, edges or tools"
      ]
    },
    {
      "dot": "rose",
      "title": "Authority sits outside the model",
      "items": [
        "Policy is a pure function of action type, role, scope and freshness",
        "Tier 4 is denied for every role; an unlisted action fails closed",
        "The gateway is the only path to a state change: policy, then approval, then idempotent claim"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence and boundaries",
      "items": [
        "Every artefact is SIM- prefixed and written to a simulation store",
        "The ledger is append-only and replays event through outcome",
        "No mine system, PLC, SCADA, dispatch, ERP or CMMS is connected"
      ]
    }
  ]
